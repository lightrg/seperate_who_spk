              <div class="subsection">
                <h3>Description</h3>
                <p>Removes all labels attached to an asset.</p>
              </div>
              <div class="subsection">
        <pre class="codeExampleCS">using UnityEngine;
using <a href="UnityEditor.html">UnityEditor</a>;
public class AssetDatabaseExamples : <a href="MonoBehaviour.html">MonoBehaviour</a>
{
    [<a href="MenuItem.html">MenuItem</a>("<a href="AssetDatabase.html">AssetDatabase</a>/Clear Labels")]
    static void ClearAssetLabels()
    {
        for (var i = 0; i &lt; 10; i++)
        {
            var prefabPath = $"Assets/Prefabs/Litter/Litter{i}.prefab";
            var asset = <a href="AssetDatabase.LoadMainAssetAtPath.html">AssetDatabase.LoadMainAssetAtPath</a>(prefabPath);
            <a href="AssetDatabase.ClearLabels.html">AssetDatabase.ClearLabels</a>(asset);
        }
    }
}</pre>
