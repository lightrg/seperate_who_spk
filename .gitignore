# ===== Large data files (audio) =====
# NOTE: output/ is NOT excluded — it contains JSON/CSV/MD/PNG evaluation results that SHOULD be committed
*.zip
!tool/tool.zip

# Audio files in data/ are too large for git (data/ is ~30GB)
data/
# Allow data directory to exist but exclude audio content
!data/.gitkeep

